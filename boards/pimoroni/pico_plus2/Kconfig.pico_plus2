config BOARD_PICO_PLUS2
	select SOC_RP2350B_HAZARD3 if BOARD_PICO_PLUS2_RP2350B_HAZARD3
	select SOC_RP2350B_M33 if BOARD_PICO_PLUS2_RP2350B_M33 \
        || BOARD_PICO_PLUS2_RP2350B_M33_W \
        || BOARD_PICO_PLUS2_RP2350B_M33_MCUBOOT \
        || BOARD_PICO_PLUS2_RP2350B_M33_W_MCUBOOT
	select MEMC
	select MEMC_RP2350_PSRAM
